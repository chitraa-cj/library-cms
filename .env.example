# Strapi
STRAPI_URL=
STRAPI_API_TOKEN=

# AWS S3 grantha draft backups (durable versioned backups on Save).
# Leave S3_BACKUP_BUCKET empty to disable — Save still works, no backup is written.
S3_BACKUP_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hermex + Gemini (browser automation — see docs/HERMEX.md)
HERMEX_ENABLED=true
# HERMEX_PYTHON=.venv-hermex/bin/python3
# HERMEX_TRANSLATE_TIMEOUT_MS=7200000
# HERMEX_CHUNK_SIZE=3
# HERMEX_CHUNK_DELAY_MS=8000
# HERMEX_MAX_RETRIES=3
# HERMEX_HEADLESS_FALLBACK=1
# On macOS, retry with visible Chrome when headless cannot connect (set 0 to disable).
# HERMEX_GRANTHA_NAME=Chandogya Upanishad

# Gemini — OCR Docs (admin-only PDF/scan transcription). Without it the page
# shows "not configured" and uploads are rejected.
GEMINI_API_KEY=
# Optional tuning (defaults shown):
# OCR_MODEL_FAST=gemini-3.8-flash        # thinking off
# OCR_MODEL_ACCURATE=gemini-3.8-flash    # thinking on; set to a Pro model if the key has Pro quota
# OCR_CHUNK_SIZE=8              # pages per Gemini request
# OCR_CONCURRENCY=4             # requests in flight across the whole server
# OCR_MAX_ACTIVE_JOBS=2         # documents worked on at once
# OCR_REQUESTS_PER_MINUTE=12   # keep below the key's own per-minute quota
# OCR_REQUESTS_PER_DAY=1500
# OCR_MAX_UPLOAD_MB=120
# OCR_MAX_PAGES=1500
# OCR_MAX_ATTEMPTS=4            # per page range, then it is left for "Retry failed"
# OCR_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
#                               # tried when the chosen model is out of DAILY quota or answers
#                               # 503 "high demand" (separate quota and capacity per model).
#                               # Verify with: node --import tsx --env-file=.env \
#                               #   script/ocr-probe-models.mts
# OCR_RETENTION_DAYS=30
# OCR_STORAGE_DIR=              # defaults to <repo>/.ocr-store

# Claude — OCR → Grantha structure analysis (admin-only). Without it the
# "Create Grantha from OCR" wizard reports "not configured" and refuses to start.
ANTHROPIC_API_KEY=
# Required ONLY when the key above belongs to the organisation rather than to one
# workspace. An unscoped key is refused with "This API key is not scoped to a workspace,
# so this request must include the anthropic-workspace-id header"; set the workspace to
# bill here (Claude Console → Settings → Workspaces), or use a workspace-scoped key.
# ANTHROPIC_WORKSPACE_ID=
# Optional tuning (defaults shown):
# STRUCTURE_MODEL=claude-opus-5          # one place for the model name
# STRUCTURE_EFFORT=high                  # low|medium|high|xhigh|max — thinking depth
# STRUCTURE_PAGES_PER_CHUNK=10           # OCR pages per Claude request
# STRUCTURE_MAX_CHARS_PER_CHUNK=60000    # character ceiling per request (overrides pages)
# STRUCTURE_CARRY_OVER_CHARS=1500        # tail of the previous range sent as context
# STRUCTURE_MAX_OUTPUT_TOKENS=32000
# STRUCTURE_CONCURRENCY=2                # requests in flight across the whole server
# STRUCTURE_MAX_ACTIVE_JOBS=1            # documents analysed at once (ranges run in order)
# STRUCTURE_REQUESTS_PER_MINUTE=20
# STRUCTURE_REQUESTS_PER_DAY=800
# STRUCTURE_MAX_ATTEMPTS=3               # per page range, then "Retry failed ranges"
# STRUCTURE_REQUEST_TIMEOUT_MS=600000
# STRUCTURE_MAX_PAGES=1500
# STRUCTURE_MAX_INSTRUCTION_CHARS=8000
# STRUCTURE_CONFIDENCE_THRESHOLD=0.7     # below this, a passage is flagged for review
# STRUCTURE_PROMPT_CACHING=true          # cache the rules+hierarchy prefix across ranges
# ANTHROPIC_BASE_URL=                    # only for a gateway/proxy
#
# ── Spend caps. A request count does not bound the bill (one request can be 60k in /
# 32k out), so these are enforced in dollars, computed from the token counters the API
# returns and summed in Postgres — a restart cannot hand out a fresh budget. The wizard
# shows the estimate and the remaining budget BEFORE the Analyse button, and refuses the
# job if it does not fit. Measured sizes at Opus 5 list prices:
#   100 pages ≈ $6 · 300 pages ≈ $23 · 800 pages ≈ $62
# STRUCTURE_MAX_SPEND_PER_JOB_USD=30     # one document; 0 disables this gate
# STRUCTURE_MAX_SPEND_PER_DAY_USD=60     # resets 00:00 UTC
# STRUCTURE_MAX_SPEND_PER_MONTH_USD=400
# STRUCTURE_MAX_REQUESTS_PER_JOB=200     # belt to the spend braces
#
# ── Prices, used for both the estimate and the caps. CHANGE THESE WITH THE MODEL, or the
# portal will quote a stale figure. Defaults are Claude Opus 5 list prices.
# STRUCTURE_PRICE_INPUT_PER_1M=5
# STRUCTURE_PRICE_OUTPUT_PER_1M=25
# STRUCTURE_PRICE_CACHE_READ_PER_1M=0.5
# STRUCTURE_PRICE_CACHE_WRITE_PER_1M=6.25
# STRUCTURE_CHARS_PER_TOKEN=2.5          # estimator: pessimistic, Devanagari is dense
# STRUCTURE_OUTPUT_RATIO=1.35            # estimator: items echo the source text back
# STRUCTURE_PROMPT_OVERHEAD_TOKENS=1800  # estimator: the cached prefix per request

# Translation jobs — the admin-only queue + background worker.
# See docs/TRANSLATION-JOBS.md. The worker is a SEPARATE process
# (pm2 app `cms-translation-worker`); the web API never translates.
# MAX_TRANSLATION_RETRIES=3           # attempts per mantra before it parks as failed
# TRANSLATION_TIMEOUT=7200000         # hard ceiling for ONE mantra, ms (2h)
# WORKER_POLL_INTERVAL=15000          # idle sleep between queue polls, ms
# TRANSLATION_ITEM_DELAY_MS=5000      # pause between mantras, ms
# TRANSLATION_LEASE_MS=900000         # claim lease; a lapsed lease = crashed worker (15m)
# TRANSLATION_LEASE_HEARTBEAT_MS=60000
# TRANSLATION_RETRY_BACKOFF_MS=60000  # per attempt already made
# TRANSLATION_MAX_ITEMS_PER_JOB=20000
# TRANSLATION_WORKER_HEADLESS=true    # false only on a desktop with a display
# TRANSLATION_WORKER_ID=              # defaults to worker-<pid>@<hostname>

# ── Hermex on EC2 (deployment configuration — these paths do NOT exist on a Mac) ──
# The persistent, already-authenticated Hermex install. Set these in the EC2
# .env only; locally leave them unset and the adapter falls back to .venv-hermex.
# The Chrome profile holds the Gemini login: it stays on the server, never in git.
# HERMEX_DIR=/home/ubuntu/hermex-translation
# HERMEX_PYTHON=/home/ubuntu/hermex-translation/.venv/bin/python
# HERMEX_CHROME_PROFILE=/home/ubuntu/hermex-translation/chrome-profile
# HERMEX_DISPLAY=:99                   # Xvfb; the adapter sets this on the Chrome child
# HERMEX_HEADLESS=                     # unset = headful when a display is set (the EC2 mode)
# HERMEX_SMOKE_TIMEOUT_MS=240000
