# Strapi
STRAPI_URL=
STRAPI_API_TOKEN=

# AWS S3 grantha draft backups (durable versioned backups on Save).
# Leave S3_BACKUP_BUCKET empty to disable — Save still works, no backup is written.
S3_BACKUP_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hermex + Gemini (browser automation — see docs/HERMEX.md)
HERMEX_ENABLED=true
# HERMEX_PYTHON=.venv-hermex/bin/python3
# HERMEX_TRANSLATE_TIMEOUT_MS=7200000
# HERMEX_CHUNK_SIZE=3
# HERMEX_CHUNK_DELAY_MS=8000
# HERMEX_MAX_RETRIES=3
# HERMEX_HEADLESS_FALLBACK=1
# On macOS, retry with visible Chrome when headless cannot connect (set 0 to disable).
# HERMEX_GRANTHA_NAME=Chandogya Upanishad
