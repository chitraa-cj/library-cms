STRAPI_URL=
STRAPI_API_TOKEN=

# Hermex + Gemini (browser automation — see docs/HERMEX.md)
HERMEX_ENABLED=true
# HERMEX_PYTHON=.venv-hermex/bin/python3
# HERMEX_TRANSLATE_TIMEOUT_MS=7200000
# HERMEX_CHUNK_SIZE=3
# HERMEX_CHUNK_DELAY_MS=8000
# HERMEX_MAX_RETRIES=3
# HERMEX_HEADLESS_FALLBACK=1
