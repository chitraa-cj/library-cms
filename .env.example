# Strapi
STRAPI_URL=
STRAPI_API_TOKEN=

# AWS S3 grantha draft backups (durable versioned backups on Save).
# Leave S3_BACKUP_BUCKET empty to disable — Save still works, no backup is written.
S3_BACKUP_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hermex + Gemini (browser automation — see docs/HERMEX.md)
HERMEX_ENABLED=true
# HERMEX_PYTHON=.venv-hermex/bin/python3
# HERMEX_TRANSLATE_TIMEOUT_MS=7200000
# HERMEX_CHUNK_SIZE=3
# HERMEX_CHUNK_DELAY_MS=8000
# HERMEX_MAX_RETRIES=3
# HERMEX_HEADLESS_FALLBACK=1
# On macOS, retry with visible Chrome when headless cannot connect (set 0 to disable).
# HERMEX_GRANTHA_NAME=Chandogya Upanishad

# OCR Docs (admin-only PDF/scan transcription) — Gemini through Hermex ONLY. No API key,
# no local OCR engine, no fallback. Uses the SAME dedicated profile as OCR → Grantha
# (HERMEX_STRUCTURE_CHROME_PROFILE below — never translation's); the two take turns on it.
# GET /api/admin/ocr/health reports what is missing. Optional tuning (defaults shown):
# OCR_CHUNK_SIZE=1              # pages per Gemini request = the unit of retry/resume
# OCR_MAX_CHUNK_SIZE=5
# OCR_MAX_ATTEMPTS=3            # requests per range (unusable answer / recoverable error)
# OCR_HERMEX_TIMEOUT_MS=300000  # one range's answer (+ OCR_HERMEX_PER_PAGE_TIMEOUT_MS per extra page)
# OCR_HERMEX_PER_PAGE_TIMEOUT_MS=120000
# OCR_HERMEX_LAUNCH_TIMEOUT_MS=360000
# OCR_HERMEX_RETRY_BASE_MS=15000
# OCR_HERMEX_TRANSIENT_COOLDOWN_MS=60000
# OCR_STALE_AFTER_MS=120000     # a running job silent this long is requeued
# OCR_MAX_UPLOAD_MB=120
# OCR_MAX_PAGES=1500
# OCR_RETENTION_DAYS=30
# OCR_STORAGE_DIR=              # defaults to <repo>/.ocr-store

# OCR → Grantha structure analysis (admin-only) — Hermex on a DEDICATED Gemini login.
# Never translation's account: a separate Chrome profile + separate Google account, so
# translation's session, lock and web quota are never touched. One-time login:
#   npm run hermex:setup-structure     (opens Chrome; log in; press Enter)
# Without it the "Create Grantha from OCR" wizard reports "not configured".
# HERMEX_STRUCTURE_CHROME_PROFILE=/home/ubuntu/hermex-structure/chrome-profile
# HERMEX_STRUCTURE_LOCK_FILE=        # default <profile>.lock — never translation's lock
# HERMEX_STRUCTURE_HEADLESS=         # default follows HERMEX_DISPLAY (headful under Xvfb)
# Optional tuning (defaults shown):
# STRUCTURE_PAGES_PER_CHUNK=3            # OCR pages per request
# STRUCTURE_MAX_CHARS_PER_CHUNK=5000     # keep small: Gemini web refuses big prompts from EC2
# STRUCTURE_CARRY_OVER_CHARS=600         # tail of the previous range sent as context
# STRUCTURE_REQUESTS_PER_MINUTE=4        # on the dedicated account
# STRUCTURE_REQUESTS_PER_DAY=300
# STRUCTURE_MAX_REQUESTS_PER_JOB=600
# STRUCTURE_MAX_ATTEMPTS=3               # per page range, then "Retry failed ranges"
# STRUCTURE_TRANSIENT_COOLDOWN_MS=60000  # after Gemini's canned error reply; do not lower
# STRUCTURE_REQUEST_TIMEOUT_MS=900000
# STRUCTURE_LAUNCH_TIMEOUT_MS=360000     # browser launch + login check + warm-up
# STRUCTURE_STALE_AFTER_MS=300000        # a running job silent this long is requeued
# STRUCTURE_MAX_PAGES=1500
# STRUCTURE_MAX_INSTRUCTION_CHARS=4000
# STRUCTURE_CONFIDENCE_THRESHOLD=0.7     # below this, a passage is flagged for review

# Translation jobs — the admin-only queue + background worker.
# See docs/TRANSLATION-JOBS.md. The worker is a SEPARATE process
# (pm2 app `cms-translation-worker`); the web API never translates.
# MAX_TRANSLATION_RETRIES=3           # attempts per mantra before it parks as failed
# TRANSLATION_TIMEOUT=7200000         # hard ceiling for ONE mantra, ms (2h)
# WORKER_POLL_INTERVAL=15000          # idle sleep between queue polls, ms
# TRANSLATION_ITEM_DELAY_MS=5000      # pause between mantras, ms
# TRANSLATION_LEASE_MS=900000         # claim lease; a lapsed lease = crashed worker (15m)
# TRANSLATION_LEASE_HEARTBEAT_MS=60000
# TRANSLATION_RETRY_BACKOFF_MS=60000  # per attempt already made
# TRANSLATION_MAX_ITEMS_PER_JOB=20000
# TRANSLATION_WORKER_HEADLESS=true    # false only on a desktop with a display
# TRANSLATION_WORKER_ID=              # defaults to worker-<pid>@<hostname>

# ── Hermex on EC2 (deployment configuration — these paths do NOT exist on a Mac) ──
# The persistent, already-authenticated Hermex install. Set these in the EC2
# .env only; locally leave them unset and the adapter falls back to .venv-hermex.
# The Chrome profile holds the Gemini login: it stays on the server, never in git.
# HERMEX_DIR=/home/ubuntu/hermex-translation
# HERMEX_PYTHON=/home/ubuntu/hermex-translation/.venv/bin/python
# HERMEX_CHROME_PROFILE=/home/ubuntu/hermex-translation/chrome-profile
# HERMEX_DISPLAY=:99                   # Xvfb; the adapter sets this on the Chrome child
# HERMEX_HEADLESS=                     # unset = headful when a display is set (the EC2 mode)
# HERMEX_SMOKE_TIMEOUT_MS=240000
