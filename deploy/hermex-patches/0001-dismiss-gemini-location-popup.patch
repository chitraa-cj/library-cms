+    def _dismiss_popups(self) -> None:
+        """Close any transient prompt covering the composer.
+
+        Gemini intermittently offers things like "Use precise location for
+        Gemini?" in a card that overlaps `rich-textarea`; the next click on the
+        composer then raises `ElementClickInterceptedException`. Clicking the
+        decline button clears it. Does nothing when no such prompt is on screen,
+        and never touches the affirmative button.
+        """
+        for label in self.DISMISS_BUTTON_LABELS:
+            xpath = (
+                "//*[self::button or @role='button']["
+                f"normalize-space(translate(., '{_ASCII_UPPER}', '{_ASCII_LOWER}'))"
+                f"='{label}' or "
+                f"normalize-space(translate(@aria-label, '{_ASCII_UPPER}',"
+                f" '{_ASCII_LOWER}'))='{label}']"
+            )
+            for button in self.driver.find_elements(By.XPATH, xpath):
+                try:
+                    if not button.is_displayed() or not button.is_enabled():
+                        continue
+                    button.click()
+                    self.sleep(0.3)
+                except WebDriverException:
+                    # Already gone, re-rendered, or not interactable: either way the
+                    # overlay is not ours to insist on. The caller retries its click.
+                    continue
+
+    def _click_composer(self, input_box: WebElement) -> WebElement:
+        """Click the composer, surviving a prompt that appears mid-interaction.
+
+        A prompt can render between locating `rich-textarea` and clicking it, so
+        one interception is not a failure yet: decline the prompt, re-locate the
+        composer (the old reference may be stale) and try the real click again.
+        """
+        wait = WebDriverWait(self.driver, 20)
+        for attempt in range(3):
+            try:
+                input_box.click()
+                return input_box
+            except (
+                ElementClickInterceptedException,
+                StaleElementReferenceException,
+            ):
+                if attempt == 2:
+                    raise
+                self._dismiss_popups()
+                input_box = wait.until(
+                    EC.element_to_be_clickable((By.TAG_NAME, "rich-textarea"))
+                )
+        return input_box
+
